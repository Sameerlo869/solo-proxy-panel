filename = "app.py"
with open(filename, "r", encoding="utf-8") as f:
    lines = f.readlines()

new_lines = []
i = 0
while i < len(lines):
    line = lines[i]
    if line.strip().startswith("try:"):
        # Check if there is an except or finally within the next 4 lines
        has_handler = False
        for lookahead in range(1, 5):
            if i + lookahead < len(lines):
                l_str = lines[i + lookahead].strip()
                if l_str.startswith("except") or l_str.startswith("finally"):
                    has_handler = True
                    break
        
        if not has_handler:
            print(f"Comment out orphan try statement at line {i+1}: {line.strip()}")
            new_lines.append("# [Fixed Orphan Try] " + line)
        else:
            new_lines.append(line)
    else:
        new_lines.append(line)
    i += 1

with open(filename, "w", encoding="utf-8") as f:
    f.writelines(new_lines)

try:
    compile("".join(new_lines), filename, 'exec')
    print("SUCCESS! app.py compiled cleanly with zero try-syntax errors.")
except Exception as e:
    print(f"Still has error: {e}")
